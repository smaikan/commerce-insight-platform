{
  "name": "ecommerce-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:orders:browser": "playwright test --config=playwright.performance.config.ts",
    "test:e2e:accounting": "playwright test --config=playwright.accounting.config.ts",
    "api:types": "openapi-typescript ../docs/api/api-project-docs/openapi-controller-contract.json -o src/generated/api.ts",
    "api:types:check": "openapi-typescript ../docs/api/api-project-docs/openapi-controller-contract.json -o src/generated/api.ts --check"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
