{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "EmailConfirmationTokenHours": 24,
    "PasswordResetTokenMinutes": 30,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "Jwt": {
    "Issuer": "ECommerce.API",
    "Audience": "ECommerce.Client",
    "SecretKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
